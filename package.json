{
  "name": "@symawe/viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Browser viewer for AWE simulation runs exported as Arrow with an embedded awesIO structure topology.",
  "files": ["dist"],
  "main": "./dist/SymAWEViewer.js",
  "module": "./dist/SymAWEViewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/SymAWEViewer.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "build": "pnpm generate && vite build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm generate && tsc -p tsconfig.build.json --noEmit && tsc --noEmit",
    "test": "pnpm generate && vitest run --bail 1",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "apache-arrow": "^21.2.0"
  },
  "peerDependencies": {
    "@react-three/drei": ">=10",
    "@react-three/fiber": ">=9",
    "react": ">=19",
    "react-dom": ">=19",
    "three": ">=0.174"
  },
  "devDependencies": {
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "json-schema-to-typescript": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
